# Copy this file to .env and fill in your own token. .env is git-ignored.
#
# Fine-grained personal access token (https://github.com/settings/tokens?type=beta)
# scoped to your own repos with read-only "Contents" and "Metadata" access is enough.
# Used only at build time by scripts/fetch-repos.mjs to list your private repos
# on the /github page — it never ships to the browser.
GITHUB_TOKEN=
